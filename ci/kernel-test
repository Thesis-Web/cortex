#!/usr/bin/env python3
# ci/kernel-test (2026-11-11): the kernel held to the owner's prose, by measured numbers, on every push.
#
# The owner, 2026-11-11: "setup ci/cd in github to make sure you build it correct. the prose outlines it all multiple times ... do it correct
# without the bloat... turn the fucking hc on ... long way, then shortcut, then formula for every fucking run not wait later".
#
# What it does, from the repo alone (no brain, no dictionary is needed): builds the kernel from nk/*.c, lays the small sources of
# nk/sources-egg (make_sources.py over sat172.json), starts the kernel on a fresh stored file, tells it the base lines (nk/LINES-nk.txt: the
# born run, the standing questions, the first tools), then types lines and reads the brain's own numbers (stats, the sheet, the receipts).
# Every test names the owner's words it holds the kernel to and prints what it measured. One FAIL fails the run.
#
#   ci/kernel-test                 build, test, print, exit 0 (all pass) or 1
#   ci/kernel-test --bin PATH      test an already built kernel
#   ci/kernel-test --keep          leave the test brain and the kernel running (prints the port and the folder)
import json, os, random, shutil, socket, subprocess, sys, tempfile, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
NK = os.path.join(ROOT, "nk")
SRCS = ["wn", "gcide", "mw", "mwt", "moby", "map", "sqldoc", "measured", "guess"]
GATES = "wn=7,gcide=8,mw=9,mwt=10,moby=11,map=12,sqldoc=13,measured=14,guess=15"
CFLAGS = ["-O2", "-Wall", "-Wno-unused-function", "-Wno-unused-parameter", "-Wno-misleading-indentation", "-I."]
LIBS = ["-L/usr/lib/x86_64-linux-gnu", "-l:libsqlite3.so.0", "-lpthread", "-lm", "-ldl"]

# the budgets (bytes of the stored file's use). Set from the kernel's own measured numbers with room; a change that costs more fails here.
REPEAT_BYTES = 16          # a repeat under a key, each, over 2,000 (the owner: "like maybe 15 bytes total")
FORMULA_BYTES = 16         # a formula's arrival, each, plus FORMULA_PER_VALUE per value
FORMULA_PER_VALUE = 6
NEW_LINE_BYTES = 8192      # a new short line (seven words), everything it leaves
NEW_LINE_RUNS = 30         # the runs a new short line makes in both brains
LONG_LINE_RECEIPTS = 16    # the receipts a new line of 400 known words writes, with everything under it (the kernel before 11-11: one for every hop, over 400)
REPEAT_STEP_BYTES = 64     # one repeat alone may take one small block (the list's next size); over many repeats the average is REPEAT_BYTES

def free_port():
    s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p

class Brain:
    def __init__(self, port): self.port = port
    def ask(self, req):
        s = socket.create_connection(("127.0.0.1", self.port), timeout=600); s.sendall((req + "\n").encode()); buf = b""
        while True:
            d = s.recv(1 << 20)
            if not d: break
            buf += d
            if buf.endswith(b"\n"): break
        s.close(); return json.loads(buf.decode())
    def q(self, sql):
        r = self.ask("q " + sql)
        if r.get("error"): raise RuntimeError("brain: %s :: %s" % (r["error"], sql[:160]))
        return r["rows"]
    def stats(self):
        s = self.ask("stats"); return {"main": s["main"]["runs"], "sixth": s["sixth"]["runs"], "pastes": s["main"]["pastes"], "used": s["map_used"],
                                       "hops": s["main"]["hops"], "dropped": s["main"]["receipts_dropped"], "refused": s["main"]["refused"], "receipts": s["main"]["receipts"]}
    def step(self, req):
        a = self.stats(); r = self.ask(req); b = self.stats()
        r["_d"] = {k: b[k] - a[k] for k in a}; return r
    def gate(self, sym):
        rows = self.q("SELECT gate FROM main.label WHERE symbol = '%s'" % sym.replace("'", "''")); return rows[0][0] if rows else 0
    def cell(self, run, word):
        g = self.gate(word)
        if not g: return []
        rows = self.q("SELECT value FROM main.run_sheet WHERE run = %d AND cell = %d AND state = 1" % (run, g))
        return [int(x) for x in str(rows[0][0]).split()] if rows and rows[0][0] is not None else []
    def cells(self, run):
        return {r[0]: r[1] for r in self.q("SELECT l.symbol, s.value FROM main.run_sheet s JOIN main.label l ON l.gate = s.cell WHERE s.run = %d" % run)}
    def seq(self, run): return [r[0] for r in self.q("SELECT gate FROM main.seq WHERE run = %d ORDER BY pos" % run)]
    def text(self, run):
        # a line read back through the encoder by its number; a formula's arrival has a number of its own (the memory + arrival * 2^32) and the kernel
        # reads it back as the learned line with that arrival's values in its places
        if not hasattr(self, "_sym"): self._sym = {}
        out = []
        for g in self.seq(run):
            if g not in self._sym: self._sym[g] = self.q("SELECT symbol FROM main.label WHERE gate = %d" % g)[0][0]
            out.append(self._sym[g])
        return "".join(out)

RESULTS = []
def check(name, words, ok, measured):
    RESULTS.append((name, bool(ok))); print("%s  %s\n      the owner: %s\n      measured: %s" % ("PASS" if ok else "FAIL", name, words, measured)); sys.stdout.flush()

def main():
    keep = "--keep" in sys.argv; binp = sys.argv[sys.argv.index("--bin") + 1] if "--bin" in sys.argv else None
    work = tempfile.mkdtemp(prefix="kernel-test-")
    if not binp:
        binp = os.path.join(work, "nk")
        r = subprocess.run(["gcc"] + CFLAGS + ["-o", binp, "nk.c", "nkvt.c", "nkio.c", "nkmap.c", "nkxyz.c"] + LIBS, cwd=NK, capture_output=True, text=True)
        if r.returncode != 0: print(r.stderr); print("FAIL  the kernel does not build"); sys.exit(1)
        if r.stderr.strip(): print("build warnings:\n" + r.stderr)
    src = os.path.join(work, "src")
    subprocess.run([sys.executable, os.path.join(NK, "sources-egg", "make_sources.py"), os.path.join(NK, "sources-egg", "sat172.json"), src, GATES], check=True, capture_output=True)
    port = free_port(); env = dict(os.environ, NK_MAP=os.path.join(work, "brain.map"))
    log = open(os.path.join(work, "nk.log"), "w")
    proc = subprocess.Popen([binp, str(port), "egg-symbols.txt", src] + SRCS, cwd=NK, env=env, stdout=log, stderr=log)
    try:
        for _ in range(100):
            try: socket.create_connection(("127.0.0.1", port), timeout=1).close(); break
            except OSError: time.sleep(0.1)
        else: print(open(os.path.join(work, "nk.log")).read()); print("FAIL  the kernel did not start"); sys.exit(1)
        subprocess.run([sys.executable, os.path.join(NK, "nkbottom.py"), str(port), "--lines", os.path.join(NK, "LINES-nk.txt"), "--ledger", os.path.join(work, "ledger.md"), "--quiet"], check=True, capture_output=True)
        b = Brain(port); s0 = b.stats()
        print("the test brain: %d main runs, %d sixth runs, %d bytes used after the base lines (port %d, %s)\n" % (s0["main"], s0["sixth"], s0["used"], port, work))
        tests(b)
    finally:
        if keep: print("\nkept: port %d, folder %s, pid %d" % (port, work, proc.pid))
        else:
            proc.terminate()
            try: proc.wait(timeout=30)
            except subprocess.TimeoutExpired: proc.kill()
            shutil.rmtree(work, ignore_errors=True)
    bad = [n for n, ok in RESULTS if not ok]
    print("\n%d tests, %d passed, %d failed%s" % (len(RESULTS), len(RESULTS) - len(bad), len(bad), (": " + "; ".join(bad)) if bad else ""))
    sys.exit(1 if bad else 0)


    check("11 the formula: a learned line with a few other values is the formula's memory and its variables",
          '"an entire sentance can be reduced to the formula gate and the varibles ... it can just have a few values representing the entire sentance" (11-10); "Substitution theory ... You already know the formula" (10-01)',
          ok11 and s1["main"] == s0["main"] and s1["sixth"] == s0["sixth"] and s1["hops"] == s0["hops"] and back == n and per <= FORMULA_BYTES + FORMULA_PER_VALUE * k and steps[0] == steps[1] and steps[2] == steps[0] * k,
          "the learned line ran the long way once (%d runs); then %d lines with other values: runs +%d, hops +%d, %d were the formula's arrivals, %.1f bytes each (budget %d + %d x %d values), %d of %d read back exactly; time, key, variable in step %s" % (longway, n, s1["main"] + s1["sixth"] - s0["main"] - s0["sixth"], s1["hops"] - s0["hops"], nform, per, FORMULA_BYTES, FORMULA_PER_VALUE, k, back, n, steps))
    r0 = b.ask("type main two cat sat by the mat now"); r1 = b.ask("typemark main ingest probe @%d | two cat sat by the bed now" % (T2 + 1500))
    check("11b a formula learned from a line first heard at the bare prompt reads back its arrivals, not the learned line",
          '"Substitution theory is that I have a variable that I have to substitute into this formula. That\'s it. You already know the formula" (10-01)',
          r1.get("formula") == 1 and r1["run"] & 0xffffffff == r0["run"] and b.text(r1["run"]) == "two cat sat by the bed now" and b.text(r0["run"]) == "two cat sat by the mat now",
          "learned line %d read back %r; its arrival %d read back %r" % (r0["run"], b.text(r0["run"]), r1["run"], b.text(r1["run"])))
    # ---- 12. a word the brain has never held is born and defined the long way first; a bare line is always answered; a tool line is never a formula
    r = b.step("typemark main ingest probe @%d | one zebra is by the mat now" % (T2 + 2000))
    r2 = b.step("type main the horse is on the floor today")
    r3 = b.step("type main print sheet : 2"); say3 = [o[3] for o in r3.get("out", []) if o[2] == "say"]
    check("12 a new word runs the long way first; a bare line is always answered; a line that asks a tool always runs",
          '"all unknown words we defined first automaticatly" (11-10); "every reply is an answer or a question" (10-12); "You already know the formula ... The compute\'s already been done" (10-01)',
          not r.get("tick") and r["_d"]["main"] >= 1 and b.gate("zebra") > 0 and len(r2.get("out", [])) >= 3 and not r3.get("tick") and r3["_d"]["main"] >= 1 and bool(say3),
          "the line with the new word: %d runs, the word\'s gate %d; the bare line: tick %s formula %s, %d runs, %d answer cells; the tool line with another value: tick %s, %d runs, it said: %s" % (r["_d"]["main"], b.gate("zebra"), r2.get("tick"), r2.get("formula"), r2["_d"]["main"], len(r2.get("out", [])), r3.get("tick"), r3["_d"]["main"], bool(say3)))
    # ---- 13. a key is always a memory of its own: two keys that differ in one word are two memories, each under its own project
    b.ask("typemark main receipt alpha 9 @%d | the dog is on the mat today" % (T2 + 3000)); b.ask("typemark main project alpha | receipt alpha 9")
    b.ask("typemark main receipt beta 9 @%d | the dog is on the mat today" % (T2 + 3001)); b.ask("typemark main project beta | receipt beta 9")
    PA = b.ask("typemark main project alpha | receipt alpha 9"); PB = b.ask("typemark main project beta | receipt beta 9")
    ka, kb = PA["run"], PB["run"]; ra, rb = b.cell(PA["marker"], "receipt"), b.cell(PB["marker"], "receipt")
    check("13 a key is a memory of its own, filed under its own project (a line used as a key is never taken as another line\'s formula)",
          '"anywhere else a memory lives not is just a pointer to that memory" (10-03); "similar to a file tree" (11-10 16:12)',
          ka != kb and ka < (1 << 32) and kb < (1 << 32) and ra == [ka] and rb == [kb] and b.text(ka) == "receipt alpha 9" and b.text(kb) == "receipt beta 9" and f in b.cell(ka, "receipt") and f in b.cell(kb, "receipt"),
          "key memories %d and %d; project alpha receipt %s, project beta receipt %s; each key holds the sentence %d: %s" % (ka, kb, ra, rb, f, f in b.cell(ka, "receipt") and f in b.cell(kb, "receipt")))
    # ---- 14. nothing was refused along the way, and the brain comes back from its file as it was
    s = b.stats()
    check("14 no step was refused", '"report only what was observed as live output" (handler)', s["refused"] <= 1, "refused %d (the base lines leave 1: the born run's first reply, before ok has a gate)" % s["refused"])


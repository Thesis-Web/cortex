#!/usr/bin/env bash
# ci/nowords (2026-11-10): the no-words gate on the Cortex brain, run on every commit (ci/hooks/post-commit, post-merge).
#
# The owner, 2026-11-10: "make a ci/cd test that locks the db if there is any words inside the neuron data base... I don't care
# how it gets there, if it doesn't get there from the encoder it does not belong, this is a test that is run on every commit...
# only gate numbers period... because the ci/cd will lock the database it should be able to be unlocked to fix it, but on a
# 10 minute timer... that test cleared turns off that timer".
#
# What is scanned (the liaison's reading, written down so a change to it shows in a commit):
#   brain files  : brain/brain.map.main.db, brain/brain.map.sixth.db. Every plain table, every row, every column.
#   source files : each db in nk/sources/LIST, but only what is outside the source shape (SOURCE_TABLES / SOURCE_TRIGGERS below).
#                  The source shape holds dictionary and doc text by design (the owner, 11-04: code and sources live outside the
#                  brain as source dbs and return through the encoder). Anything else in a source db, e.g. cx.judge_jev*, is
#                  scanned like the brain.
#   words        : a cell whose typeof() is 'text' or 'blob'. integer, real and null are numbers. A trigger or a view in a scanned
#                  place is words too (code stored as text). Table and column names in CREATE TABLE are the schema, not counted.
#   not scanned  : the kernel's own virtual tables (CREATE VIRTUAL TABLE .. USING nk). Their rows live in the map file
#                  (brain.map), the kernel refuses a scan of them (nkvt.c xBestIndex), and label is the encoder itself.
#                  Any virtual table of another module is counted as words (it cannot be read here).
#
# The lock: a holder process keeps a sqlite RESERVED lock (BEGIN IMMEDIATE) on the brain files and on every source file with a
# finding. Every write through the kernel (q door, cortex.py, triggers, lay scripts) then fails at once with "database is
# locked"; reads go on. Nothing in the db is changed by the test or the lock.
#
# States: CLEAR (no lock), LOCKED (holder running), WINDOW (unlocked, a timer relocks at the deadline).
#   check   : scan and act. PASS -> CLEAR from any state (stops the holder and the timer). FAIL -> LOCKED from CLEAR or LOCKED;
#             in a WINDOW a FAIL leaves the timer running. UNREAD (a file missing or busy) -> no change. Exit 0/1/2.
#   scan    : scan only, never changes the state. Exit 0 pass, 1 words found, 2 unread.
#   status  : the state, the window's time left, whether the holder holds, the last report.
#   unlock  : LOCKED -> WINDOW for NOWORDS_WINDOW seconds (default 600). At the deadline the test runs again: PASS -> CLEAR,
#             otherwise LOCKED. Only from LOCKED: a window is not extended, it relocks first.
#   There is no verb that clears the lock without a passing test.
set -u

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=${NOWORDS_ROOT:-$(cd "$(dirname "$SELF")/.." && pwd)}
MAIN_DB=${NOWORDS_MAIN:-$ROOT/brain/brain.map.main.db}
SIXTH_DB=${NOWORDS_SIXTH:-$ROOT/brain/brain.map.sixth.db}
SRC_DIR=${NOWORDS_SOURCES:-$ROOT/nk/sources}
# the state is kept per brain file, so a copy of the repo (a rail check's work folder) never touches the live brain's lock
STATE_DIR=${NOWORDS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/cortex-nowords/$(printf '%s' "$MAIN_DB" | tr '/' '_')}
WINDOW=${NOWORDS_WINDOW:-600}
BUSY_MS=${NOWORDS_BUSY_MS:-60000}

SOURCE_TABLES=" me corpus words inbox outbox "
SOURCE_TRIGGERS=" work work_word work_pair carry "

mkdir -p "$STATE_DIR"
STATE_FILE=$STATE_DIR/state
REPORT=$STATE_DIR/report
LOG=$STATE_DIR/log

now() { date +%s; }
stamp() { date '+%Y-%m-%d %H:%M:%S %Z'; }
log() { printf '%s %s\n' "$(stamp)" "$*" >> "$LOG"; }
sq() { sqlite3 -batch -noheader -readonly -cmd ".timeout $BUSY_MS" "$@"; }

# ---- the state file: three lines, state / since / until
get_state() { if [ -f "$STATE_FILE" ]; then sed -n 1p "$STATE_FILE"; else echo CLEAR; fi; }
get_until() { [ -f "$STATE_FILE" ] && sed -n 3p "$STATE_FILE"; }
put_state() { printf '%s\n%s\n%s\n' "$1" "$(now)" "${2:-}" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"; }

# ---- the scan: prints one line per finding and a "lock <file>" line per file with words; FOUND / UNREAD flags
FOUND=0; UNREAD=0
scan_file() {   # $1 label, $2 file, $3 mode: brain | source
  local label=$1 f=$2 mode=$3 found=0 rows type name sql c q out total i n line
  local -a cols sums
  if [ ! -r "$f" ]; then echo "UNREAD $label: $f missing"; UNREAD=1; return; fi
  if ! rows=$(sq "$f" "SELECT type || char(9) || name || char(9) || replace(replace(coalesce(sql,''), char(10), ' '), char(9), ' ') FROM sqlite_schema WHERE type IN ('table','trigger','view') AND name NOT LIKE 'sqlite_%' ORDER BY type, name" 2>&1); then
    echo "UNREAD $label: $f: $rows"; UNREAD=1; return
  fi
  while IFS=$'\t' read -r type name sql; do
    [ -n "$type" ] || continue
    if [ "$mode" = source ]; then
      case $type in
        table)   [[ "$SOURCE_TABLES" == *" $name "* ]] && continue ;;
        trigger) [[ "$SOURCE_TRIGGERS" == *" $name "* ]] && continue ;;
      esac
    fi
    if [ "$type" != table ]; then echo "WORDS $label $type $name: code stored as text in the db"; found=1; continue; fi
    if [[ "${sql^^}" =~ ^CREATE[[:space:]]+VIRTUAL ]]; then
      [[ "$sql" =~ [Uu][Ss][Ii][Nn][Gg][[:space:]]+nk[[:space:]]*\( ]] && continue
      echo "WORDS $label table $name: a virtual table of another module, not readable here: ${sql:0:80}"; found=1; continue
    fi
    if ! out=$(sq "$f" "SELECT name FROM pragma_table_info('${name//\'/\'\'}')" 2>&1); then
      echo "UNREAD $label table $name: $out"; UNREAD=1; continue
    fi
    mapfile -t cols <<< "$out"
    [ -n "${cols[0]:-}" ] || continue
    q="SELECT count(*)"
    for c in "${cols[@]}"; do q+=", coalesce(sum(typeof(\"${c//\"/\"\"}\") IN ('text','blob')), 0)"; done
    q+=" FROM \"${name//\"/\"\"}\""
    if ! out=$(sq -separator '|' "$f" "$q" 2>&1); then echo "UNREAD $label table $name: $out"; UNREAD=1; continue; fi
    IFS='|' read -r -a sums <<< "$out"
    total=${sums[0]}; line=""; i=1
    for c in "${cols[@]}"; do n=${sums[$i]:-0}; [ "$n" != 0 ] && line+=" $c=$n"; i=$((i+1)); done
    if [ -n "$line" ]; then echo "WORDS $label table $name ($total rows), text or blob cells:$line"; found=1; fi
  done <<< "$rows"
  if [ $found = 1 ]; then echo "lock $f"; FOUND=1; fi
}

do_scan() {   # writes $REPORT; returns 0 pass, 1 words (a word found anywhere is a fail even if a file was not read), 2 unread
  local s
  FOUND=0; UNREAD=0
  {
    echo "no-words scan $(stamp)"
    scan_file main "$MAIN_DB" brain
    scan_file sixth "$SIXTH_DB" brain
    if [ -r "$SRC_DIR/LIST" ]; then
      for s in $(cat "$SRC_DIR/LIST"); do scan_file "$s" "$SRC_DIR/$s.db" source; done
    else
      echo "UNREAD sources: $SRC_DIR/LIST missing"; UNREAD=1
    fi
    if [ $FOUND = 1 ]; then echo "FAIL: words in the brain"
    elif [ $UNREAD = 1 ]; then echo "UNREAD: the brain was not fully read"
    else echo "PASS: no words in the brain"; fi
  } > "$REPORT.tmp" 2>&1
  mv "$REPORT.tmp" "$REPORT"
  [ $FOUND = 1 ] && return 1
  [ $UNREAD = 1 ] && return 2
  return 0
}

# ---- the holder and the timer: process groups started with setsid, pid files in the state dir
alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
stop_group() { if alive "$1"; then kill -TERM -- "-$(cat "$1")" 2>/dev/null; sleep 0.3; kill -KILL -- "-$(cat "$1")" 2>/dev/null; fi; rm -f "$1"; }

lock_files() {   # the brain files plus every file the last report found words in; only files that exist (sqlite would make a missing one)
  local f
  { echo "$MAIN_DB"; echo "$SIXTH_DB"; sed -n 's/^lock //p' "$REPORT" 2>/dev/null; } | awk 'NF && !seen[$0]++' | while read -r f; do [ -f "$f" ] && echo "$f"; done
}

probe_locked() {   # 0 when a second connection cannot take the write lock on $1 (it writes nothing either way)
  local out; out=$(sqlite3 -batch -cmd ".timeout 0" "$1" "BEGIN IMMEDIATE; ROLLBACK;" 2>&1)
  [[ "$out" == *"locked"* ]]
}
all_held() { local f; for f in "$@"; do probe_locked "$f" || return 1; done; return 0; }

hold_start() {
  local files=() f sql i=0
  mapfile -t files < <(lock_files)
  [ ${#files[@]} -gt 0 ] || { echo "LOCK NOT TAKEN: no brain file to lock"; return 1; }
  if alive "$STATE_DIR/holder.pid" && [ "$(printf '%s\n' "${files[@]}")" = "$(cat "$STATE_DIR/holder.files" 2>/dev/null)" ] && all_held "${files[@]}"; then
    return 0   # the same files are held already: no gap
  fi
  stop_group "$STATE_DIR/holder.pid"
  sql=".timeout 120000"$'\n'
  for f in "${files[@]:1}"; do i=$((i+1)); sql+="ATTACH '${f//\'/\'\'}' AS nowords_$i;"$'\n'; done
  sql+="BEGIN IMMEDIATE;"$'\n'"SELECT 'held';"$'\n'
  rm -f "$STATE_DIR/holder.out"
  printf '%s\n' "${files[@]}" > "$STATE_DIR/holder.files"
  # one sqlite3 connection, the brain file as main and the others attached; BEGIN IMMEDIATE takes the write lock on every one of
  # them and the connection then waits forever on stdin. -bail: if the lock is not taken in 120 s it exits and never says held.
  NOWORDS_SQL=$sql setsid bash -c '{ printf "%s" "$NOWORDS_SQL"; exec sleep infinity; } | exec sqlite3 -batch -bail -noheader "$1"' nowords-holder "${files[0]}" \
    < /dev/null > "$STATE_DIR/holder.out" 2>&1 9>&- &
  echo $! > "$STATE_DIR/holder.pid"
  local t=0
  while [ $t -lt 1250 ]; do
    grep -q '^held$' "$STATE_DIR/holder.out" 2>/dev/null && break
    alive "$STATE_DIR/holder.pid" || break
    sleep 0.1; t=$((t+1))
  done
  for f in "${files[@]}"; do
    if ! probe_locked "$f"; then echo "LOCK NOT TAKEN on $f: $(tr '\n' ' ' < "$STATE_DIR/holder.out")"; stop_group "$STATE_DIR/holder.pid"; return 1; fi
  done
  return 0
}

timer_start() {
  stop_group "$STATE_DIR/timer.pid"
  setsid bash -c 'sleep "$1"; exec "$2" _expire' nowords-timer "$WINDOW" "$SELF" < /dev/null >> "$LOG" 2>&1 9>&- &
  echo $! > "$STATE_DIR/timer.pid"
}

# ---- the state changes, one at a time (flock)
locked_section() {
  exec 9> "$STATE_DIR/flock"
  flock -w 600 9 || { echo "no-words: another check holds the state for 10 minutes; nothing changed"; exit 2; }
}

go_clear() {
  stop_group "$STATE_DIR/timer.pid"; stop_group "$STATE_DIR/holder.pid"
  put_state CLEAR
}

go_locked() {
  stop_group "$STATE_DIR/timer.pid"
  if hold_start; then put_state LOCKED; return 0; fi
  put_state LOCKED; return 1
}

verb_check() {
  locked_section
  local rc st left why=${NOWORDS_WHY:-by hand}
  do_scan; rc=$?; st=$(get_state)
  cat "$REPORT"
  case $rc in
    0) go_clear; log "check ($why): PASS, $st -> CLEAR"; echo "no-words: PASS -> CLEAR (lock released, timer off)";;
    1) if [ "$st" = WINDOW ] && alive "$STATE_DIR/timer.pid"; then
         left=$(( $(get_until) - $(now) )); log "check ($why): FAIL inside the window, ${left}s left"
         echo "no-words: FAIL inside the unlock window; it relocks in ${left}s unless a check passes first"
       elif go_locked; then
         log "check ($why): FAIL, $st -> LOCKED $(tr '\n' ' ' < "$STATE_DIR/holder.files")"
         echo "no-words: FAIL -> LOCKED. Writes to the brain are refused. To fix: $SELF unlock (10 minutes), remove the words, commit."
       else
         log "check ($why): FAIL, $st -> LOCKED, the lock NOT taken"
         echo "no-words: FAIL -> LOCKED, BUT THE LOCK WAS NOT TAKEN (see above); the next check tries again"
       fi;;
    *) log "check ($why): UNREAD, $st kept"; echo "no-words: UNREAD -> state $st kept";;
  esac
  return $rc
}

verb_expire() {   # the timer's end
  locked_section
  [ "$(get_state)" = WINDOW ] || exit 0
  rm -f "$STATE_DIR/timer.pid"
  do_scan; local rc=$?
  if [ $rc = 0 ]; then go_clear; log "window ended: PASS -> CLEAR"
  elif go_locked; then log "window ended: $( [ $rc = 1 ] && echo FAIL || echo UNREAD ) -> LOCKED $(tr '\n' ' ' < "$STATE_DIR/holder.files")"
  else log "window ended: -> LOCKED, the lock NOT taken"; fi
}

verb_unlock() {
  locked_section
  local st; st=$(get_state)
  case $st in
    LOCKED)
      stop_group "$STATE_DIR/holder.pid"
      put_state WINDOW $(( $(now) + WINDOW )); timer_start
      log "UNLOCKED for ${WINDOW}s"
      echo "no-words: unlocked for $((WINDOW / 60)) min $((WINDOW % 60)) s (until $(date -d "@$(get_until)" '+%H:%M:%S %Z')). A passing check clears the lock for good; otherwise it relocks at the deadline.";;
    WINDOW) echo "no-words: already unlocked, $(( $(get_until) - $(now) ))s left; a window is not extended";;
    *) echo "no-words: not locked (state $st)";;
  esac
}

verb_status() {
  local st; st=$(get_state)
  echo "state: $st since $(date -d "@$(sed -n 2p "$STATE_FILE" 2>/dev/null || now)" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null)"
  if [ "$st" = WINDOW ]; then echo "window: $(( $(get_until) - $(now) ))s left, timer $(alive "$STATE_DIR/timer.pid" && echo running || echo GONE)"; fi
  if alive "$STATE_DIR/holder.pid"; then
    local f; while read -r f; do echo "holder: $(probe_locked "$f" && echo holds || echo 'does NOT hold') $f"; done < "$STATE_DIR/holder.files"
  else
    echo "holder: none"; [ "$st" = LOCKED ] && echo "WARNING: the state is LOCKED but no holder runs (a reboot?); the next check takes the lock again"
  fi
  [ -f "$REPORT" ] && { echo "last report:"; sed 's/^/  /' "$REPORT"; }
}

case ${1:-} in
  check)   verb_check ;;
  scan)    do_scan; rc=$?; cat "$REPORT"; exit $rc ;;
  status)  verb_status ;;
  unlock)  verb_unlock ;;
  _expire) verb_expire ;;
  *) echo "usage: $0 check | scan | status | unlock"; exit 2 ;;
esac
